module use /global/common/software/m3169/perlmutter/modulefiles 2>/dev/null || true
module load openmpi 2>/dev/null || true
module load cudatoolkit 2>/dev/null || true

if [[ -n "${PSCRATCH:-}" ]]; then
  export TMPDIR="$PSCRATCH"
  mkdir -p "$TMPDIR"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="{{REPO_DIR}}"
WESTPA_PREFIX=$(python3 "$REPO_DIR/benchmark.py" read-config paths.westpa_env_prefix 2>/dev/null || echo "/global/cfs/cdirs/m4229/caden/micromamba_root/envs/westpa_env")

export MAMBA_EXE='{{MAMBA_EXE}}'
export MAMBA_ROOT_PREFIX='{{MAMBA_ROOT_PREFIX}}'
export PATH="$WESTPA_PREFIX/bin:$PATH"
export CONDA_PREFIX="$WESTPA_PREFIX"

export HDF5_USE_FILE_LOCKING=0
export MPI=1

export WEST_SIM_ROOT="$PWD"
export SIM_NAME=$(basename "$WEST_SIM_ROOT")

export WM_N_WORKERS=1
