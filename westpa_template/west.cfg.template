west: 
  system:
    driver: westpa.core.systems.WESTSystem
    system_options:
      pcoord_ndim: {{PCOORD_NDIM}}
      pcoord_len: {{PCOORD_LEN}}
      pcoord_dtype: !!python/name:numpy.float32
      bins:
          type: MABBinMapper
          nbins: [{{NBINS}}]       
          mab_log: true
      bin_target_counts: {{BIN_TARGET_COUNTS}}
 
  propagation:
    max_total_iterations: {{TARGET_ITERATIONS}}
    max_run_wallclock:    {{MAX_RUN_WALLCLOCK}}
    propagator:           openmm_explicit_rmsd_p_ca_propagator.OpenMMExplicitPropagator
    gen_istates:          false
    block_size:           1
  
  data:
    west_data_file: $WEST_SIM_ROOT/west.h5
    datasets:
      - name:        pcoord
        scaleoffset: 4
    data_refs:
      segment:       $WEST_SIM_ROOT/traj_segs/{segment.n_iter:06d}/{segment.seg_id:06d}
      basis_state:   $WEST_SIM_ROOT/bstates/bstates.txt
      initial_state: $WEST_SIM_ROOT/istates/{initial_state.iter_created}/{initial_state.state_id}.xml

  openmm:
    topology_path: {{PROJECT_DIR}}/{{PDB_ID}}_WP/processed/{{PDB_ID}}_processed.pdb
    num_gpus: {{NUM_GPUS}}                
    gpu_precision: {{GPU_PRECISION}} 
    forcefield:
{{FF_LIST}}
    temperature: {{TEMPERATURE}}           # K
    timestep: {{TIMESTEP}}                # fs
    friction: {{FRICTION}}                # 1/ps
    pressure: {{PRESSURE}}                # atm
    barostatInterval: {{BAROSTAT_INTERVAL}}
    constraintTolerance: {{CONSTRAINT_TOLERANCE}}
    hydrogenMass: {{HYDROGEN_MASS}}            # amu
    steps: {{STEPS}}
    save_steps: {{SAVE_STEPS}}
